generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceCategory {
  IPHONE
  IPAD
  GALAXY_S
}

enum InventoryStatus {
  PROCESSING
  WIPING_DATA
  REPAIR
  FINAL_QA
  LISTED
  RESERVED
  SOLD
  RETURNED
  QUARANTINE
}

enum PurchaseStatus {
  SUBMITTED
  APPROVED
  RECEIVED
  IN_INSPECTION
  REVISED_OFFER_SENT
  PAID
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
}

enum ReturnReason {
  CHANGED_MIND
  FAULTY
  NOT_AS_DESCRIBED
  OTHER
}

model DeviceModel {
  id             String         @id @default(cuid())
  category       DeviceCategory
  name           String
  releaseYear    Int
  basePriceEUR   Int
  storageOptions Json
  createdAt      DateTime       @default(now())

  inventoryItems InventoryItem[]
  purchases      Purchase[]

  @@index([category])
}

model InventoryItem {
  id               String          @id @default(cuid())
  model            DeviceModel     @relation(fields: [modelId], references: [id])
  modelId          String
  storageGb        Int
  storageLabel     String
  condition        Json
  listPriceEUR     Int
  status           InventoryStatus @default(LISTED)
  sourcePurchaseId String?
  imei             String?
  createdAt        DateTime        @default(now())

  orders Order[]

  @@index([status])
  @@index([modelId])
  @@index([imei])
}

model Purchase {
  id               String         @id @default(cuid())
  model            DeviceModel    @relation(fields: [modelId], references: [id])
  modelId          String
  storageGb        Int
  storageLabel     String
  condition        Json
  offerEUR         Int
  status           PurchaseStatus @default(SUBMITTED)
  countryCode      String
  countryName      String
  customerName     String         @default("")
  customerEmail    String         @default("")
  payoutIban       String         @default("")
  revisedOfferEUR  Int?
  revisedOfferNote String         @default("")
  createdAt        DateTime       @default(now())

  @@index([countryCode])
  @@index([createdAt])
  @@index([modelId])
}

model Order {
  id              String        @id @default(cuid())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String
  priceEUR        Int
  status          OrderStatus   @default(PENDING)
  countryCode     String
  countryName     String
  customerName    String
  customerEmail   String
  shippingAddress String        @default("")
  city            String        @default("")
  postalCode      String        @default("")
  stripeSessionId String?
  createdAt       DateTime      @default(now())

  returnRequests ReturnRequest[]

  @@index([countryCode])
  @@index([createdAt])
  @@index([stripeSessionId])
}

model ReturnRequest {
  id              String       @id @default(cuid())
  order           Order        @relation(fields: [orderId], references: [id])
  orderId         String
  reason          ReturnReason
  customerNote    String       @default("")
  status          ReturnStatus @default(REQUESTED)
  adminNote       String       @default("")
  refundAmountEUR Int?
  stripeRefundId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
}
